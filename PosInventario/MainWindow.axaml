<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:PosInventario.Views"
        xmlns:vm="using:PosInventario.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:DataType="vm:MainViewModel"
        x:Class="PosInventario.MainWindow"
        Title="Sistema de inventario"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="560"
        Background="{StaticResource ContentBackgroundBrush}">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:InicioViewModel">
            <views:InicioView/>
        </DataTemplate>
        <DataTemplate DataType="vm:CajaViewModel">
            <views:CajaView/>
        </DataTemplate>
        <DataTemplate DataType="vm:ProductosViewModel">
            <views:ProductosView/>
        </DataTemplate>
        <DataTemplate DataType="vm:ProveedoresViewModel">
            <views:ProveedoresView/>
        </DataTemplate>
        <DataTemplate DataType="vm:ClientesViewModel">
            <views:ClientesView/>
        </DataTemplate>
        <DataTemplate DataType="vm:InventarioViewModel">
            <views:InventarioView/>
        </DataTemplate>
        <DataTemplate DataType="vm:ComprasViewModel">
            <views:ComprasView/>
        </DataTemplate>
        <DataTemplate DataType="vm:VentasViewModel">
            <views:VentasView/>
        </DataTemplate>
        <DataTemplate DataType="vm:ReportesViewModel">
            <views:ReportesView/>
        </DataTemplate>
        <DataTemplate DataType="vm:UsuariosViewModel">
            <views:UsuariosView/>
        </DataTemplate>
        <DataTemplate DataType="vm:ConfiguracionViewModel">
            <views:ConfiguracionView/>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="262,*">

        <views:SidebarView Grid.Column="0"/>

        <Grid Grid.Column="1" RowDefinitions="76,*">

            <Border Grid.Row="0"
                    Background="{StaticResource NavyGradientBrush}"
                    Padding="28,0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Sistema de inventario"
                                   FontSize="19"
                                   FontWeight="ExtraBold"
                                   Foreground="{StaticResource SurfaceBrush}"/>
                        <TextBlock Text="{Binding TituloVistaActual}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SidebarTextBrush}"
                                   Opacity="0.75"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding VistaActual}"/>

        </Grid>
    </Grid>
</Window>
