<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:PosInventario.Styles"
             xmlns:vm="using:PosInventario.ViewModels"
             x:DataType="vm:MainViewModel"
             x:Class="PosInventario.Views.SidebarView">

    <UserControl.Resources>
        <conv:VistaActualConverter x:Key="VistaFondo"/>
        <conv:VistaActualConverter x:Key="VistaTexto" Modo="texto"/>
        <conv:VistaActualConverter x:Key="VistaBarra" Modo="barra"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.navPill">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Margin" Value="12,3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource SidebarGradientBrush}">
        <Grid RowDefinitions="Auto,*,Auto">

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="22,26,16,22"
                        Spacing="12">
                <Border Width="42" Height="42" CornerRadius="21"
                        Background="{StaticResource NavyBrush}">
                    <TextBlock Text="S"
                               FontSize="20"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource SurfaceBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="Sistema de inventario"
                               FontSize="20"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource NavyBrush}"/>
                    <TextBlock Text="Aplicación de escritorio"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource NavyBrush}"
                               Opacity="0.75"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,8,0,8">

                    <Button Classes="navPill"
                            Command="{Binding IrAInicioCommand}"
                            Background="{Binding VistaActual, Converter={StaticResource VistaFondo}, ConverterParameter=InicioViewModel}">
                        <Grid ColumnDefinitions="3,Auto,*">
                            <Border Grid.Column="0"
                                    Width="3" Height="24" CornerRadius="2"
                                    Background="{StaticResource AccentBarBrush}"
                                    Opacity="{Binding VistaActual, Converter={StaticResource VistaBarra}, ConverterParameter=InicioViewModel}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="Inicio"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding VistaActual, Converter={StaticResource VistaTexto}, ConverterParameter=InicioViewModel}"/>
                        </Grid>
                    </Button>

                    <Button Classes="navPill"
                            Command="{Binding IrAElementosCommand}"
                            Background="{Binding VistaActual, Converter={StaticResource VistaFondo}, ConverterParameter=ElementosViewModel}">
                        <Grid ColumnDefinitions="3,Auto,*">
                            <Border Grid.Column="0"
                                    Width="3" Height="24" CornerRadius="2"
                                    Background="{StaticResource AccentBarBrush}"
                                    Opacity="{Binding VistaActual, Converter={StaticResource VistaBarra}, ConverterParameter=ElementosViewModel}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="Elementos"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding VistaActual, Converter={StaticResource VistaTexto}, ConverterParameter=ElementosViewModel}"/>
                        </Grid>
                    </Button>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="18,10" Background="#26000000">
                <TextBlock Text="{Binding TextoVersionMenu}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource NavyBrush}"
                           HorizontalAlignment="Center"/>
            </Border>

        </Grid>
    </Border>
</UserControl>
