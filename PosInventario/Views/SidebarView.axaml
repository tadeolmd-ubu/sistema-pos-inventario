<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:PosInventario.Styles"
             xmlns:vm="using:PosInventario.ViewModels"
             x:DataType="vm:MainViewModel"
             x:Class="PosInventario.Views.SidebarView">

    <UserControl.Resources>
        <conv:VistaActualConverter x:Key="VistaFondo"/>
        <conv:VistaActualConverter x:Key="VistaTexto" Modo="texto"/>
        <conv:VistaActualConverter x:Key="VistaBarra" Modo="barra"/>
        <conv:InicialesConverter x:Key="Iniciales"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.navPill">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Margin" Value="12,3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource SidebarGradientBrush}">
        <Grid RowDefinitions="Auto,*,Auto,Auto">

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="22,26,16,22"
                        Spacing="12">
                <Border Width="42" Height="42" CornerRadius="21"
                        Background="{StaticResource NavyBrush}">
                    <TextBlock Text="S"
                               FontSize="20"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource SurfaceBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="Sistema de inventario"
                               FontSize="20"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource NavyBrush}"/>
                    <TextBlock Text="Aplicación de escritorio"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource NavyBrush}"
                               Opacity="0.75"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,8,0,8">

                    <Button Classes="navPill"
                            Command="{Binding IrAInicioCommand}"
                            Background="{Binding VistaActual, Converter={StaticResource VistaFondo}, ConverterParameter=InicioViewModel}">
                        <Grid ColumnDefinitions="3,Auto,*">
                            <Border Grid.Column="0"
                                    Width="3" Height="24" CornerRadius="2"
                                    Background="{StaticResource AccentBarBrush}"
                                    Opacity="{Binding VistaActual, Converter={StaticResource VistaBarra}, ConverterParameter=InicioViewModel}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="Inicio"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding VistaActual, Converter={StaticResource VistaTexto}, ConverterParameter=InicioViewModel}"/>
                        </Grid>
                    </Button>

                    <Button Classes="navPill"
                            Command="{Binding IrACajaCommand}"
                            Background="{Binding VistaActual, Converter={StaticResource VistaFondo}, ConverterParameter=CajaViewModel}">
                        <Grid ColumnDefinitions="3,Auto,*">
                            <Border Grid.Column="0"
                                    Width="3" Height="24" CornerRadius="2"
                                    Background="{StaticResource AccentBarBrush}"
                                    Opacity="{Binding VistaActual, Converter={StaticResource VistaBarra}, ConverterParameter=CajaViewModel}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="Caja"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding VistaActual, Converter={StaticResource VistaTexto}, ConverterParameter=CajaViewModel}"/>
                        </Grid>
                    </Button>

                    <Button Classes="navPill"
                            IsVisible="{Binding EsAdministrador}"
                            Command="{Binding IrAProductosCommand}"
                            Background="{Binding VistaActual, Converter={StaticResource VistaFondo}, ConverterParameter=ProductosViewModel}">
                        <Grid ColumnDefinitions="3,Auto,*">
                            <Border Grid.Column="0"
                                    Width="3" Height="24" CornerRadius="2"
                                    Background="{StaticResource AccentBarBrush}"
                                    Opacity="{Binding VistaActual, Converter={StaticResource VistaBarra}, ConverterParameter=ProductosViewModel}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="Productos"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding VistaActual, Converter={StaticResource VistaTexto}, ConverterParameter=ProductosViewModel}"/>
                        </Grid>
                    </Button>

                    <Button Classes="navPill"
                            IsVisible="{Binding EsAdministrador}"
                            Command="{Binding IrAProveedoresCommand}"
                            Background="{Binding VistaActual, Converter={StaticResource VistaFondo}, ConverterParameter=ProveedoresViewModel}">
                        <Grid ColumnDefinitions="3,Auto,*">
                            <Border Grid.Column="0"
                                    Width="3" Height="24" CornerRadius="2"
                                    Background="{StaticResource AccentBarBrush}"
                                    Opacity="{Binding VistaActual, Converter={StaticResource VistaBarra}, ConverterParameter=ProveedoresViewModel}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="Proveedores"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding VistaActual, Converter={StaticResource VistaTexto}, ConverterParameter=ProveedoresViewModel}"/>
                        </Grid>
                    </Button>

                    <Button Classes="navPill"
                            IsVisible="{Binding EsAdministrador}"
                            Command="{Binding IrAInventarioCommand}"
                            Background="{Binding VistaActual, Converter={StaticResource VistaFondo}, ConverterParameter=InventarioViewModel}">
                        <Grid ColumnDefinitions="3,Auto,*">
                            <Border Grid.Column="0"
                                    Width="3" Height="24" CornerRadius="2"
                                    Background="{StaticResource AccentBarBrush}"
                                    Opacity="{Binding VistaActual, Converter={StaticResource VistaBarra}, ConverterParameter=InventarioViewModel}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="Inventario"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding VistaActual, Converter={StaticResource VistaTexto}, ConverterParameter=InventarioViewModel}"/>
                        </Grid>
                    </Button>

                    <Button Classes="navPill"
                            IsVisible="{Binding EsAdministrador}"
                            Command="{Binding IrAComprasCommand}"
                            Background="{Binding VistaActual, Converter={StaticResource VistaFondo}, ConverterParameter=ComprasViewModel}">
                        <Grid ColumnDefinitions="3,Auto,*">
                            <Border Grid.Column="0"
                                    Width="3" Height="24" CornerRadius="2"
                                    Background="{StaticResource AccentBarBrush}"
                                    Opacity="{Binding VistaActual, Converter={StaticResource VistaBarra}, ConverterParameter=ComprasViewModel}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="Compras"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding VistaActual, Converter={StaticResource VistaTexto}, ConverterParameter=ComprasViewModel}"/>
                        </Grid>
                    </Button>

                    <Button Classes="navPill"
                            IsVisible="{Binding EsAdministrador}"
                            Command="{Binding IrAVentasCommand}"
                            Background="{Binding VistaActual, Converter={StaticResource VistaFondo}, ConverterParameter=VentasViewModel}">
                        <Grid ColumnDefinitions="3,Auto,*">
                            <Border Grid.Column="0"
                                    Width="3" Height="24" CornerRadius="2"
                                    Background="{StaticResource AccentBarBrush}"
                                    Opacity="{Binding VistaActual, Converter={StaticResource VistaBarra}, ConverterParameter=VentasViewModel}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="Ventas"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding VistaActual, Converter={StaticResource VistaTexto}, ConverterParameter=VentasViewModel}"/>
                        </Grid>
                    </Button>

                    <Button Classes="navPill"
                            IsVisible="{Binding EsAdministrador}"
                            Command="{Binding IrAUsuariosCommand}"
                            Background="{Binding VistaActual, Converter={StaticResource VistaFondo}, ConverterParameter=UsuariosViewModel}">
                        <Grid ColumnDefinitions="3,Auto,*">
                            <Border Grid.Column="0"
                                    Width="3" Height="24" CornerRadius="2"
                                    Background="{StaticResource AccentBarBrush}"
                                    Opacity="{Binding VistaActual, Converter={StaticResource VistaBarra}, ConverterParameter=UsuariosViewModel}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="Usuarios"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding VistaActual, Converter={StaticResource VistaTexto}, ConverterParameter=UsuariosViewModel}"/>
                        </Grid>
                    </Button>

                    <Button Classes="navPill"
                            IsVisible="{Binding EsAdministrador}"
                            Command="{Binding IrAConfiguracionCommand}"
                            Background="{Binding VistaActual, Converter={StaticResource VistaFondo}, ConverterParameter=ConfiguracionViewModel}">
                        <Grid ColumnDefinitions="3,Auto,*">
                            <Border Grid.Column="0"
                                    Width="3" Height="24" CornerRadius="2"
                                    Background="{StaticResource AccentBarBrush}"
                                    Opacity="{Binding VistaActual, Converter={StaticResource VistaBarra}, ConverterParameter=ConfiguracionViewModel}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="Configuración"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding VistaActual, Converter={StaticResource VistaTexto}, ConverterParameter=ConfiguracionViewModel}"/>
                        </Grid>
                    </Button>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="16,10" Background="#14000000">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding ComandosTitulo, StringFormat='Comandos · {0}'}"
                               FontSize="11"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource NavyBrush}"
                               TextWrapping="Wrap"
                               Opacity="0.9"/>

                    <ItemsControl ItemsSource="{Binding ComandosItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AtajoItem">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="8"
                                      Margin="0,1">
                                    <Border Background="{StaticResource SurfaceBrush}"
                                            CornerRadius="4"
                                            Padding="5,1"
                                            MinWidth="34"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Tecla}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource NavyBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Descripcion}"
                                               FontSize="11"
                                               Foreground="{StaticResource NavyBrush}"
                                               Opacity="0.9"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="F1 para ver todos los atajos"
                               FontSize="10"
                               Foreground="{StaticResource NavyBrush}"
                               Opacity="0.6"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Padding="18,12" Background="#26000000">
                <StackPanel Spacing="8">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border Width="34" Height="34" CornerRadius="17"
                                Background="{StaticResource NavyBrush}">
                            <TextBlock Text="{Binding NombreUsuarioActual, Converter={StaticResource Iniciales}}"
                                       FontSize="13"
                                       FontWeight="ExtraBold"
                                       Foreground="{StaticResource SurfaceBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="{Binding NombreUsuarioActual}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource NavyBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding RolUsuarioActual}"
                                       FontSize="11"
                                       Foreground="{StaticResource NavyBrush}"
                                       Opacity="0.75"/>
                        </StackPanel>
                    </Grid>

                    <Button Content="Cerrar sesión"
                            Classes="secondary small"
                            HorizontalAlignment="Stretch"
                            Command="{Binding CerrarSesionCommand}"/>

                    <TextBlock Text="{Binding TextoVersionMenu}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource NavyBrush}"
                               HorizontalAlignment="Center"/>

                </StackPanel>
            </Border>

        </Grid>
    </Border>
</UserControl>
