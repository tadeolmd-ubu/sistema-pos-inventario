<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:PosInventario.Models"
        xmlns:vm="using:PosInventario.ViewModels"
        x:DataType="vm:SeleccionarProductoViewModel"
        x:Class="PosInventario.Views.SeleccionarProductoWindow"
        Title="Seleccionar producto"
        Width="680"
        Height="560"
        MinWidth="520"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ContentBackgroundBrush}">

    <Border Classes="card" Margin="18" Padding="24">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">

            <TextBlock Grid.Row="0"
                       Text="Seleccionar producto"
                       Classes="sectionTitle"/>

            <TextBox x:Name="BusquedaBox"
                     Grid.Row="1"
                     Text="{Binding Busqueda}"
                     PlaceholderText="Buscar por SKU o nombre..."
                     Classes="search"/>

            <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="Escribe para buscar; ↑/↓ navega, ←/→ cambia de página y Enter agrega."
                               Classes="caption"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding Paginacion.Resumen}"
                                   Classes="caption"
                                   VerticalAlignment="Center"/>

                        <ComboBox ItemsSource="{Binding Paginacion.TamanosDisponibles}"
                                  SelectedItem="{Binding Paginacion.TamanoPagina}"
                                  MinWidth="64"
                                  ToolTip.Tip="Registros por página"/>

                        <Button Content="◀"
                                Classes="secondary small"
                                Width="34"
                                Command="{Binding Paginacion.IrAnteriorCommand}"
                                ToolTip.Tip="Página anterior"/>

                        <TextBlock Text="{Binding Paginacion.PaginaTexto}"
                                   Classes="caption"
                                   VerticalAlignment="Center"/>

                        <Button Content="▶"
                                Classes="secondary small"
                                Width="34"
                                Command="{Binding Paginacion.IrSiguienteCommand}"
                                ToolTip.Tip="Página siguiente"/>
                    </StackPanel>
                </Grid>

                <ListBox x:Name="ProductosLista"
                         Grid.Row="1"
                         ItemsSource="{Binding ProductosItems}"
                         SelectedItem="{Binding SelectedProducto}"
                         DoubleTapped="Productos_DoubleTapped"
                         Classes="entityList">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Producto">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Sku}" Classes="caption"/>
                                        <TextBlock Text="·" Classes="caption"/>
                                        <TextBlock Text="{Binding PrecioVentaTexto}"
                                                   Classes="caption"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding StockTexto, StringFormat='Stock {0}'}"
                                           Classes="caption"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding MensajeOperacion}"
                           Classes="caption"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10">
                    <Button Content="Cancelar"
                            Classes="secondary"
                            IsCancel="True"
                            Click="Cancelar_Click"/>
                    <Button Content="Agregar"
                            Classes="primary"
                            IsDefault="True"
                            Command="{Binding SeleccionarCommand}"/>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
