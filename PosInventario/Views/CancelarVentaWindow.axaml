<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:PosInventario.Models"
        xmlns:vm="using:PosInventario.ViewModels"
        x:DataType="vm:CancelarVentaViewModel"
        x:Class="PosInventario.Views.CancelarVentaWindow"
        Title="Devolver venta"
        Width="600"
        SizeToContent="Height"
        MaxHeight="760"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ContentBackgroundBrush}">

    <Border Classes="card" Margin="18" Padding="24">
        <StackPanel Spacing="12">

            <TextBlock Text="Devolver venta" Classes="subsection"/>
            <TextBlock Text="Selecciona una venta de esta caja. Puedes devolver toda la venta o solo algunos productos."
                       Classes="caption"
                       TextWrapping="Wrap"/>

            <ListBox ItemsSource="{Binding VentasItems}"
                     SelectedItem="{Binding SelectedVenta}"
                     DoubleTapped="Ventas_DoubleTapped"
                     MaxHeight="360"
                     Classes="entityList">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Venta">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Id, StringFormat='V-{0:000000}'}"
                                           FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Fecha, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"
                                               Classes="caption"/>
                                    <TextBlock Text="·" Classes="caption"/>
                                    <TextBlock Text="{Binding MetodoPago}" Classes="caption"/>
                                    <TextBlock Text="·" Classes="caption"/>
                                    <TextBlock Text="{Binding Estado}" Classes="caption"/>
                                    <TextBlock Text="·" Classes="caption"/>
                                    <TextBlock Text="{Binding Usuario.Nombre}" Classes="caption"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Total, StringFormat='{}{0:0.00}'}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="{Binding MensajeOperacion}"
                       Classes="caption"
                       TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        HorizontalAlignment="Right">
                <Button Content="Cerrar"
                        Classes="secondary"
                        IsCancel="True"
                        Click="Cerrar_Click"/>
                <Button Content="Devolver"
                        Classes="primary"
                        IsVisible="{Binding PuedeDevolver}"
                        Click="Devolver_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
