<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dt="using:PosInventario.Views.DesignTime"
             xmlns:vm="using:PosInventario.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             d:DataContext="{x:Static dt:DesignTimeData.Configuracion}"
             x:DataType="vm:ConfiguracionViewModel"
             x:Class="PosInventario.Views.ConfiguracionView">

    <Border Background="{StaticResource ContentBackgroundBrush}" Padding="28,22">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="18" MaxWidth="900" HorizontalAlignment="Left">

                <StackPanel Spacing="2">
                    <TextBlock Text="Configuración" Classes="sectionTitle"/>
                    <TextBlock Text="Opciones generales del sistema" Classes="caption"/>
                </StackPanel>

                <Border Classes="cardFlat" Padding="22">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Base de datos" Classes="subsection"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Ruta actual" Classes="fieldLabel"/>
                            <TextBlock Text="{Binding RutaBaseDatos}"
                                       Classes="caption"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="cardFlat" Padding="22">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Respaldos automáticos" Classes="subsection"/>
                        <TextBlock Text="Se crea un respaldo al iniciar sesión una vez al día y otro al cerrar la caja. La retención solo elimina los respaldos automáticos fuera del período configurado; los manuales no se tocan."
                                   Classes="caption"
                                   TextWrapping="Wrap"/>

                        <CheckBox Content="Crear respaldos automáticos"
                                  IsChecked="{Binding RespaldosAutomaticos}"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Conservar respaldos de los últimos"
                                       Classes="fieldLabel"
                                       VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding OpcionesRetencionDias}"
                                      SelectedItem="{Binding RetencionDiasSeleccionados}"
                                      Width="80"
                                      HorizontalAlignment="Left"/>
                            <TextBlock Text="días"
                                       Classes="fieldLabel"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Content="Guardar configuración"
                                Classes="secondary"
                                Command="{Binding GuardarConfiguracionCommand}"/>
                    </StackPanel>
                </Border>

                <Border Classes="cardFlat" Padding="22">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Respaldos" Classes="subsection"/>
                        <TextBlock Text="Elige la carpeta de destino y después crea el respaldo. El respaldo no modifica la base actual."
                                   Classes="caption"
                                   TextWrapping="Wrap"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Carpeta de destino" Classes="fieldLabel"/>
                            <TextBlock Text="{Binding CarpetaDestinoRespaldo}"
                                       Classes="caption"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Crear respaldo"
                                    Classes="primary"
                                    Click="CrearRespaldo_Click"/>
                            <Button Content="Elegir carpeta..."
                                    Classes="secondary"
                                    Click="ElegirCarpeta_Click"/>
                        </StackPanel>

                        <Border Background="{StaticResource SurfaceAltBrush}"
                                CornerRadius="10"
                                Padding="12"
                                IsVisible="{Binding HayUltimoRespaldo}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Último respaldo" Classes="fieldLabel"/>
                                <TextBlock Text="{Binding UltimoRespaldoTexto}"
                                           Classes="caption"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Classes="cardFlat" Padding="22">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Restaurar respaldo" Classes="subsection"/>
                        <TextBlock Text="Reemplaza la base actual con un archivo de respaldo validado. Antes de restaurar se crea un respaldo de seguridad de la base actual."
                                   Classes="caption"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Solo un administrador puede restaurar. La aplicación se reinicia al terminar para leer la base restaurada."
                                   Classes="caption"
                                   TextWrapping="Wrap"/>

                        <Button Content="Seleccionar respaldo..."
                                Classes="danger"
                                IsEnabled="{Binding !IsBusy}"
                                Click="RestaurarRespaldo_Click"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding MensajeOperacion}"
                           Classes="caption"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
